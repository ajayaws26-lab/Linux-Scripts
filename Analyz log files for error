#!/bin/bash

LOG_DIR="/Users/nana/Logs"
ERROR_PATTERNS=("ERROR" "FATAL" "CRITICAL")
REPORT_FILE="/Users/nana/logs/log_analysis_report.txt"

echo "analyzing log files" > "$REPORT_FILE"
echo "===================" >> "$REPORT_FILE"

echo -e "\nList of log files updated in last 24 hours"
LOG_FILES=$(find $LOG_DIR -name "*.log" -mtime -1)
echo "$LOG_FILES"

for LOG_FILE in $LOG_FILES; do

	echo -e "\n" >> "$REPORT_FILE"
	echo "===============================================================" >> "$REPORT_FILE"
	echo "======================== $LOG_FILE ============================" >> "$REPORT_FILE"
	echo "===============================================================" >> "$REPORT_FILE"

	for PATTERN in ${ERROR_PATTERNS[@]}; do
	
		echo -e "\nSearching $PATTERN log in $LOG_FILE file" >> "$REPORT_FILE"
		grep "$PATTERN" "$LOG_FILE" >> "$REPORT_FILE"
		
		echo -e "\nNumber of $PATTERN logs found in $LOG_FILE" >> "$REPORT_FILE"
		grep -c "$PATTERN" "$LOG_FILE" >> "$REPORT_FILE"
	
	
	done
done
